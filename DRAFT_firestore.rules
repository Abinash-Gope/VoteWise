rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Feedback Validation
    function isValidFeedback(data) {
      return data.keys().hasAll(['rating', 'type', 'createdAt']) &&
             data.keys().size() <= 6 && // rating, type, createdAt, comment, page, userId
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.type is string && data.type in ['accuracy', 'improvement', 'helpfulness'] &&
             data.createdAt == request.time &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 2000)) &&
             (!('page' in data) || (data.page is string && data.page.size() <= 256)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    match /feedback/{feedbackId} {
      allow create: if isValidFeedback(incoming());
      allow get, list, update, delete: if false; // System only reads or admins (if we had them)
    }
  }
}
